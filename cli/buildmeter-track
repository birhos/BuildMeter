#!/bin/bash
# BuildMeter — terminal takipçisi.
#
# Kullanım: buildmeter-track <komut> [argümanlar...]
#   buildmeter-track flutter run -d ios
#   buildmeter-track fvm flutter build apk
#
# `run` için: komut başladığı andan "Flutter run key commands." satırı (uygulama
# cihazda açılıp bağlandığı an) görülene kadar geçen süre ölçülür.
# `build` için: komutun tamamı ölçülür.
# Sonuç ~/.buildmeter/events.jsonl dosyasına yazılır.

set -u

DATA_DIR="${BUILDMETER_DATA_DIR:-$HOME/.buildmeter}"
EVENTS="$DATA_DIR/events.jsonl"
mkdir -p "$DATA_DIR"

# Alt komutu bul (flutter run / fvm flutter run / fvm spawn 3.x run ...)
subcmd=""
device=""
prev=""
for arg in "$@"; do
  case "$arg" in
    run|build) [ -z "$subcmd" ] && subcmd="$arg" ;;
  esac
  case "$prev" in
    -d|--device-id) device="$arg" ;;
  esac
  case "$arg" in
    --device-id=*) device="${arg#--device-id=}" ;;
  esac
  prev="$arg"
done

if [ -z "$subcmd" ]; then
  exec "$@"
fi

# Build alt türü (apk, ipa, ios, appbundle …)
if [ "$subcmd" = "build" ]; then
  found=0
  for arg in "$@"; do
    if [ $found = 1 ]; then case "$arg" in -*) ;; *) device="$arg"; break ;; esac; fi
    [ "$arg" = "build" ] && found=1
  done
fi

# Proje adı: yukarı doğru ilk pubspec.yaml'daki `name:`
project=""
dir="$PWD"
while [ "$dir" != "/" ]; do
  if [ -f "$dir/pubspec.yaml" ]; then
    project=$(sed -n 's/^name:[[:space:]]*\([^[:space:]#]*\).*/\1/p' "$dir/pubspec.yaml" | head -n1)
    [ -z "$project" ] && project=$(basename "$dir")
    break
  fi
  dir=$(dirname "$dir")
done
[ -z "$project" ] && project=$(basename "$PWD")

now() { perl -MTime::HiRes=time -e 'printf "%.3f", time' 2>/dev/null || date +%s; }
json_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\n\r'; }

id=$(uuidgen | tr 'A-Z' 'a-z')
start=$(now)
p_esc=$(json_escape "$project")
d_esc=$(json_escape "$device")
common="\"id\":\"$id\",\"source\":\"terminal\",\"kind\":\"$subcmd\",\"project\":\"$p_esc\",\"device\":\"$d_esc\""

emit_end() { # $1 = status
  printf '{"event":"end",%s,"start":%s,"ts":%s,"status":"%s"}\n' "$common" "$start" "$(now)" "$1" >> "$EVENTS"
}

printf '{"event":"start",%s,"ts":%s,"pid":%s}\n' "$common" "$start" "$$" >> "$EVENTS"

status_for_rc() {
  case "$1" in
    0) echo "$2" ;;
    130|143|137) echo "cancelled" ;;
    *) echo "failed" ;;
  esac
}

# --- flutter build: komutun tamamını ölç ---
if [ "$subcmd" = "build" ]; then
  trap ':' INT  # Ctrl+C yalnızca flutter'ı durdursun, biz kaydı yazalım
  "$@"
  rc=$?
  emit_end "$(status_for_rc $rc success)"
  exit $rc
fi

# --- flutter run: uygulama açılana kadar ölç ---
LOG=$(mktemp -t buildmeter) || exit 1
DONE="$LOG.done"
STOP="$LOG.stop"
cleanup() { rm -f "$LOG" "$DONE" "$STOP"; }

PATTERN='Flutter run key commands\.|Dart VM Service on .* is available at|Application finished\.'

watch_log() {
  while [ ! -f "$STOP" ] && kill -0 $$ 2>/dev/null; do
    if grep -qE "$PATTERN" "$LOG" 2>/dev/null; then
      emit_end success
      touch "$DONE"
      return
    fi
    sleep 0.5
  done
}
watch_log &
watcher=$!

trap ':' INT
if [ -t 0 ] && [ -t 1 ]; then
  # script(1) gerçek bir pty açar: renkler ve r/R/q kısayolları aynen çalışır.
  script -q -F "$LOG" "$@"
  rc=$?
else
  "$@" 2>&1 | tee "$LOG"
  rc=${PIPESTATUS[0]}
fi

# İzleyiciyi durdur ve bitmesini bekle (en fazla ~0.5 sn).
touch "$STOP"
wait "$watcher" 2>/dev/null

if [ ! -f "$DONE" ]; then
  if grep -qE "$PATTERN" "$LOG" 2>/dev/null; then
    emit_end success
  else
    emit_end "$(status_for_rc $rc cancelled)"
  fi
fi
cleanup
exit $rc
