<Window x:Class="BuildMeter.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BuildMeter"
        Width="412" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource Foreground}">

    <Border Margin="12" Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource WindowBorder}"
            BorderThickness="1" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
        </Border.Effect>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">

                <!-- Başlık -->
                <DockPanel Margin="0,0,0,14">
                    <Image Source="Assets/BuildMeter.ico" Width="22" Height="22" Margin="0,0,8,0" DockPanel.Dock="Left" />
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;"
                            ToolTip="Ayarlar" AutomationProperties.Name="Ayarlar" DockPanel.Dock="Right" Click="Settings_Click" />
                    <ComboBox DockPanel.Dock="Right" Margin="0,0,6,0" MinWidth="90" VerticalAlignment="Center"
                              ItemsSource="{Binding TechOptions}" SelectedItem="{Binding TechFilter}" DisplayMemberPath="Title"
                              AutomationProperties.Name="Teknoloji filtresi"
                              Visibility="{Binding ShowTechFilter, Converter={StaticResource Visible}}" />
                    <TextBlock Text="BuildMeter" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Şu an derleniyor -->
                <Border Background="{DynamicResource ActiveBackground}" CornerRadius="8" Padding="10" Margin="0,0,0,14"
                        Visibility="{Binding HasActive, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock Text="ŞU AN DERLENİYOR" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Active}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Clock}" FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ActiveForeground}" VerticalAlignment="Center"
                                                   Typography.NumeralAlignment="Tabular" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Project}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Bugün -->
                <TextBlock Text="BUGÜN BEKLENEN SÜRE" Style="{StaticResource SectionTitle}" Margin="0" />
                <TextBlock Text="{Binding TodayTotal}" FontSize="32" FontWeight="Bold" Typography.NumeralAlignment="Tabular" />
                <UniformGrid Rows="1" Margin="0,4,0,14">
                    <StackPanel>
                        <TextBlock Text="Build" Style="{StaticResource Secondary}" FontSize="11" />
                        <TextBlock Text="{Binding Count}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Başarılı" Style="{StaticResource Secondary}" FontSize="11" />
                        <TextBlock Text="{Binding SuccessCount}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Ortalama" Style="{StaticResource Secondary}" FontSize="11" />
                        <TextBlock Text="{Binding Average}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="En uzun" Style="{StaticResource Secondary}" FontSize="11" />
                        <TextBlock Text="{Binding Longest}" FontWeight="SemiBold" />
                    </StackPanel>
                </UniformGrid>

                <!-- Teknoloji ve kaynak -->
                <StackPanel Visibility="{Binding ShowTechChips, Converter={StaticResource Visible}}">
                    <TextBlock Text="TEKNOLOJİYE GÖRE" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding TechChips}" Style="{StaticResource ChipList}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding SourceChips}" Style="{StaticResource ChipList}" Margin="0,0,0,8" />

                <!-- Son 7 gün -->
                <TextBlock Text="SON 7 GÜN" Style="{StaticResource SectionTitle}" />
                <ItemsControl ItemsSource="{Binding Week}" Margin="0,0,0,14">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="3,0" ToolTip="{Binding ToolTip}" Background="Transparent">
                                <Grid Height="88">
                                    <StackPanel VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding Value}" FontSize="10" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryForeground}" Margin="0,0,0,2" />
                                        <Border x:Name="Bar" Height="{Binding BarHeight}" CornerRadius="3,3,0,0"
                                                Background="{DynamicResource AccentMuted}" />
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource WindowBorder}" />
                                <TextBlock x:Name="Day" Text="{Binding Weekday}" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"
                                           Foreground="{DynamicResource SecondaryForeground}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Accent}" />
                                    <Setter TargetName="Day" Property="Foreground" Value="{DynamicResource Foreground}" />
                                    <Setter TargetName="Day" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Projeler -->
                <StackPanel Visibility="{Binding HasProjects, Converter={StaticResource Visible}}" Margin="0,0,0,14">
                    <TextBlock Text="PROJELER (BUGÜN)" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Projects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Border Width="{Binding FillWidth}" HorizontalAlignment="Left" CornerRadius="3"
                                            Background="{DynamicResource AccentFaint}" />
                                    <DockPanel Margin="4,2">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource Secondary}"
                                                   FontSize="13" Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Son build'ler -->
                <TextBlock Text="SON BUILD'LER" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap"
                           Visibility="{Binding HasNoRecent, Converter={StaticResource Visible}}"
                           Text="Henüz kayıt yok. Terminalden flutter run, dotnet build ya da npm run dev çalıştırın veya editörden debug başlatın." />
                <ItemsControl ItemsSource="{Binding Recent}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2" ToolTip="{Binding Detail}" Background="Transparent">
                                <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Text="{Binding StatusGlyph}" FontFamily="{StaticResource IconFont}"
                                           FontSize="12" Width="20" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForeground}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Duration}" Width="84" TextAlignment="Right"
                                           Typography.NumeralAlignment="Tabular" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Style="{StaticResource Secondary}" FontSize="13"
                                           Margin="8,0,0,0" />
                                <Border DockPanel.Dock="Right" Background="{DynamicResource ChipBackground}" CornerRadius="6" Padding="5,0"
                                        Margin="6,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding ShowKind, Converter={StaticResource Visible}}">
                                    <TextBlock Text="{Binding Kind}" FontSize="10" />
                                </Border>
                                <TextBlock Text="{Binding Project}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="success">
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="failed">
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Failure}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Rapor -->
                <Border Height="1" Background="{DynamicResource WindowBorder}" Margin="0,0,0,12" />
                <DockPanel>
                    <ComboBox ItemsSource="{Binding RangeOptions}" SelectedItem="{Binding SelectedRange}" DisplayMemberPath="Title"
                              Width="110" VerticalAlignment="Center" AutomationProperties.Name="Rapor aralığı" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Margin="6,0,0,0" Click="ExportCsv_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="CSV" />
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" HorizontalAlignment="Right" Click="CopyReport_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CopyGlyph" Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="CopyLabel" Text="Raporu kopyala" />
                        </StackPanel>
                    </Button>
                </DockPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
